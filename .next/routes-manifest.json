{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/book_appointment",
      "regex": "^/dashboard/book_appointment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/book_appointment(?:/)?$"
    },
    {
      "page": "/dashboard/doctor",
      "regex": "^/dashboard/doctor(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/doctor(?:/)?$"
    },
    {
      "page": "/dashboard/doctor/api",
      "regex": "^/dashboard/doctor/api(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/doctor/api(?:/)?$"
    },
    {
      "page": "/dashboard/feedback",
      "regex": "^/dashboard/feedback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/feedback(?:/)?$"
    },
    {
      "page": "/dashboard/inbox",
      "regex": "^/dashboard/inbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/inbox(?:/)?$"
    },
    {
      "page": "/dashboard/medhya_explainer",
      "regex": "^/dashboard/medhya_explainer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/medhya_explainer(?:/)?$"
    },
    {
      "page": "/dashboard/medhya_scriber",
      "regex": "^/dashboard/medhya_scriber(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/medhya_scriber(?:/)?$"
    },
    {
      "page": "/dashboard/records",
      "regex": "^/dashboard/records(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/records(?:/)?$"
    },
    {
      "page": "/dashboard/records/api",
      "regex": "^/dashboard/records/api(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/records/api(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/login/api",
      "regex": "^/login/api(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login/api(?:/)?$"
    },
    {
      "page": "/services",
      "regex": "^/services(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}